-- ==========================================
-- 3. CONSULTAS SQL (RESOLUÇÃO DA ATIVIDADE)
-- ==========================================

-- A. Extração de texto (substr e instr) - Identificando os domínios de e-mail
SELECT 
    nome, 
    email,
    substr(email, instr(email, '@') + 1) AS dominio_email
FROM pacientes;

-- B. Cálculo de idade com base na data de nascimento
SELECT 
    nome, 
    data_nascimento,
    CAST(strftime('%Y.%m%d', 'now') - strftime('%Y.%m%d', data_nascimento) AS INT) AS idade_atual
FROM pacientes;

-- C. Agregações e Filtros (SUM, COUNT, AVG, GROUP BY, HAVING) - Pacientes mais assíduos
SELECT 
    p.nome,
    COUNT(c.id) AS total_atendimentos,
    SUM(c.valor) AS valor_total_gasto,
    ROUND(AVG(c.valor), 2) AS ticket_medio_por_consulta
FROM pacientes p
JOIN consultas c ON p.id = c.paciente_id
GROUP BY p.nome
HAVING total_atendimentos > 1;

-- D. Mensagens concatenadas e formatação (strftime e printf) - Log do sistema
SELECT 
    p.nome || ' realizou o procedimento de "' || c.motivo_consulta || '" em ' || strftime('%d/%m/%Y', c.data_consulta) || '. Valor: R$ ' || printf('%.2f', c.valor) AS log_atendimento
FROM pacientes p
JOIN consultas c ON p.id = c.paciente_id;